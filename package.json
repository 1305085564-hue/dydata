{
  "name": "dydata",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "gate:static": "npm test && npx tsx --test scripts/create-test-users.test.ts && npx tsc --noEmit --pretty false && npm run lint && npm run build",
    "gate:browser": "npm run build && node --env-file-if-exists=.env.ai-test.local node_modules/@playwright/test/cli.js test",
    "seed:topics": "tsx scripts/seed-topic-library.ts",
    "import:reports": "npx tsx scripts/import-daily-reports.ts",
    "perf:ttfb": "node scripts/measure-ttfb.mjs",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.110.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "4.4.0",
    "framer-motion": "^12.42.2",
    "jimp": "^1.6.1",
    "lucide-react": "^0.577.0",
    "next": "16.3.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.82.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "undici": "7.29.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.31.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "postcss": "8.5.23",
    "flatted": "3.4.2",
    "form-data": "4.0.6",
    "fdir": {
      "picomatch": "4.0.5"
    },
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "router": {
      "path-to-regexp": "8.4.2"
    },
    "ws@7": "7.5.13"
  }
}
