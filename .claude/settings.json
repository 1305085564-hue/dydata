{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Read(.env)",
      "Edit(.env)",
      "Read(.env.local)",
      "Edit(.env.local)",
      "Read(.env.*.local)",
      "Edit(.env.*.local)",
      "Read(package-lock.json)",
      "Edit(package-lock.json)"
    ]
  },
  "enabledPlugins": {
    "financial-analysis@financial-services-plugins": false,
    "equity-research@financial-services-plugins": false,
    "marketing@knowledge-work-plugins": false,
    "product-management@knowledge-work-plugins": false,
    "productivity@knowledge-work-plugins": false,
    "codex@openai-codex": true
  }
}