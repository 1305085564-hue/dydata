#!/bin/sh
# 推送前自动门禁（由 `npm run hooks:install` 安装到 .git/hooks/pre-push）。
# 只放确定性、不依赖外部服务的检查；真实库测试、角色/浏览器门禁仍按发布流程单独跑。
# 推送不会自动上线，发版要另外执行 deploy-service 命令；这里是推送前最后一道自动检查。
# 不要用 --no-verify 跳过；门禁本身误报就修门禁。
set -e
cd "$(git rev-parse --show-toplevel)"
# 从工作树 push 时，git 会给钩子导出 GIT_DIR（实测）。下面的测试会在临时目录里建仓库，
# 继承它就会把 git init/config 写进真实仓库（2026-11-18 曾把 core.bare=true 和测试身份写进主仓库配置）。
# 已 cd 到仓库根目录，清掉后 git 照常按当前目录找到本仓库。
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX

# 文档链接检查放最前：秒级，失效链接让代理顺着死链找不到资料，没必要等 tsc 和单测跑完才发现。
echo "[pre-push] 1/7 文档链接检查"
node scripts/doc-health-check.mjs --links || {
  echo "[pre-push] 文档里有链接指向不存在的文件，已阻断推送。按上面逐条提示改；文件只是挪了位置的可一键修：node scripts/doc-health-check.mjs --links --fix-links" >&2
  exit 1
}

has_migration_changes() {
  git diff --name-only origin/main...HEAD -- supabase/migrations
  git diff --name-only HEAD -- supabase/migrations
  git diff --cached --name-only -- supabase/migrations
  git ls-files --others --exclude-standard -- supabase/migrations
}

if [ -n "$(has_migration_changes)" ]; then
  echo "[pre-push] 迁移改动，先在本机重放"
  if ! pg_isready -h 127.0.0.1 -p 54322 >/dev/null 2>&1; then
    echo "[pre-push] 本机数据库未启动，请先 colima start && supabase start，再重试。" >&2
    exit 1
  fi
  npm run db:replay || {
    echo "[pre-push] 迁移重放失败，已阻断推送。" >&2
    exit 1
  }
else
  echo "[pre-push] 推送范围没有迁移改动，跳过本机重放"
fi

echo "[pre-push] 2/7 类型检查"
npx tsc --noEmit --pretty false
echo "[pre-push] 3/7 单元测试（不含真实库组）"
npm test --silent > /tmp/dydata-pre-push-test.log 2>&1 || { tail -60 /tmp/dydata-pre-push-test.log; echo "[pre-push] 单元测试失败，完整输出：/tmp/dydata-pre-push-test.log"; exit 1; }
echo "[pre-push] 4/7 代码检查"
npm run lint --silent
echo "[pre-push] 5/7 设计令牌门禁"
npm run gate:design --silent
echo "[pre-push] 6/7 可维护性、源码测试与文档体量门禁（对比 origin/main）"
node scripts/maintainability-gate.mjs --base=origin/main
node scripts/source-text-test-gate.mjs
node scripts/doc-size-check.mjs
echo "[pre-push] 7/7 新增接口失败路径门禁（对比 origin/main）"
node scripts/api-failure-path-gate.mjs --base=origin/main
gate_pass_path=$(git rev-parse --git-path dydata-gate-pass)
mkdir -p "$(dirname "$gate_pass_path")"
git rev-parse HEAD > "$gate_pass_path"
echo "[pre-push] 全部通过"
