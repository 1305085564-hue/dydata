#!/bin/sh
# 推送前自动门禁（由 `npm run hooks:install` 安装到 .git/hooks/pre-push）。
# 全部检查清单统一维护在 scripts/gate-static.mjs（即 `npm run gate:static`），本钩子只负责清环境变量后调用它并写通过标记。
# 不要用 --no-verify 跳过；门禁本身误报就修门禁。
set -e
cd "$(git rev-parse --show-toplevel)"
# 从工作树 push 时，git 会给钩子导出 GIT_DIR（实测）。单测会在临时目录里建仓库，
# 继承它就会把 git init/config 写进真实仓库（2026-11-18 曾把 core.bare=true 和测试身份写进主仓库配置）。
# 已 cd 到仓库根目录，清掉后 git 照常按当前目录找到本仓库。
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX

node scripts/gate-static.mjs

gate_pass_path=$(git rev-parse --git-path dydata-gate-pass)
mkdir -p "$(dirname "$gate_pass_path")"
git rev-parse HEAD > "$gate_pass_path"
echo "[pre-push] 全部通过"
