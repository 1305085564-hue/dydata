# ────────────────────────────────────────────────────────────
# DYData 环境变量模板
# 复制本文件为 .env.local 后填入真实值；× commit 到 git
# ────────────────────────────────────────────────────────────

# ── Supabase 公开配置（前端可见） ──
NEXT_PUBLIC_SUPABASE_URL=https://gcrhhxaopomtposmahsw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<Supabase Dashboard → Project Settings → API → anon public>

# ── Sentry 错误监控（可选；未配置 DSN 时不会向外发送） ──
# DSN 属于前端公开地址，但仍只放环境变量，不写进源码；其他三项只供构建时上传 source map。
NEXT_PUBLIC_SENTRY_DSN=<Sentry Dashboard → Project Settings → Client Keys (DSN)>
SENTRY_ORG=<Sentry organization slug>
SENTRY_PROJECT=<Sentry project slug>
SENTRY_AUTH_TOKEN=<Sentry auth token: project:releases scope>
# 该值会出现在前端错误事件中，只能填写环境名称，不得放任何密钥。
NEXT_PUBLIC_SENTRY_ENVIRONMENT=<local|preview|production>
# 可选：不填时 Vercel 会使用当前 git commit 标识版本。
SENTRY_RELEASE=<release identifier>

# Supabase 密码重置配置说明
# 需要在 Supabase Dashboard 中配置重定向 URL
# 详见 docs/supabase-password-reset-config.md

# ── Supabase 服务端密钥 ──
# 用途：服务端 API 路由、cron 接口、绕 RLS 读写
# 限制：× 能执行 DDL（建表/建函数/改 schema）
SUPABASE_SERVICE_ROLE_KEY=<Supabase Dashboard → Project Settings → API → service_role>

# ── 投稿截图迁移（服务端读取；密钥只放部署环境） ──
COS_SECRET_ID=<腾讯云子账号 SecretId>
COS_SECRET_KEY=<腾讯云子账号 SecretKey>
COS_BUCKET=<COS 私有桶名>
COS_REGION=<COS 地域，例如 ap-guangzhou>
COS_APP_ID=<腾讯云 AppId>
COS_READ_TIMEOUT_MS=3000
SCREENSHOT_GRANT_SECRET=<至少 32 字节的随机票据签名密钥>
SCREENSHOT_STORAGE=supabase
SCREENSHOT_GRANT_ENABLED=1

# ── Supabase 数据库直连串（DDL 通道，Win/Codex 必填） ──
# 用途：psql 或 node-pg 直接执行 migration、临时 SQL
# 来源：Dashboard 顶部 Connect 按钮 → Connection string → Session pooler → URI
# 密码：Project Settings → Database → Database Password（忘了就 Reset）
# 安全：等同库的钥匙，× 上传 git，× 明文丢桌面，泄露立即重置
SUPABASE_DB_URL=postgresql://postgres.gcrhhxaopomtposmahsw:<DB_PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── Supabase Personal Access Token（CLI migration 通道，可选） ──
# 用途：supabase CLI 推 migrations、查 schema
# 来源：Dashboard 右上头像 → Account → Access Tokens → 新建
# 安全：可随时撤销，权限比 DB_URL 窄
SUPABASE_ACCESS_TOKEN=<sbp_xxxxxxxxxxxxxxxx>

# ── 飞书机器人 ──
FEISHU_WEBHOOK_URL=<飞书自定义机器人 webhook 地址>

# ── 飞书自建应用机器人（事件回调） ──
FEISHU_APP_ID=<飞书开放平台 → 应用 → 凭证与基础信息 → App ID>
FEISHU_APP_SECRET=<同上 → App Secret>
FEISHU_APP_ENCRYPT_KEY=<应用 → 事件与回调 → Encrypt Key>
FEISHU_APP_VERIFICATION_TOKEN=<应用 → 事件与回调 → Verification Token>

# ── Cron 接口鉴权（两个填同一个值） ──
# Vercel Cron 自动携带 Authorization: Bearer CRON_SECRET；
# 手动/外部触发可用 ?secret=<REMIND_SECRET>。vercel.json 禁止再写明文 secret。
# 安全：泄露后必须立即轮换（换新值），旧值自动失效。
CRON_SECRET=<自定义随机字符串>
REMIND_SECRET=<自定义随机字符串>

# ── API 限流存储（Upstash Redis REST，跨实例生效） ──
# 用途：src/lib/api-rate-limit.ts 按「端点 × 用户/IP」限流，保护 AI 成本接口
# 来源：Upstash Console → 创建 Database（Regional 可选 apsoutheast）→ REST
# 未配置时限流降级为单实例内存模式（跨 Vercel 实例不生效），日志会有降级警告
UPSTASH_REDIS_REST_URL=<Upstash Console → Database → REST URL>
UPSTASH_REDIS_REST_TOKEN=<同上 → REST Token>

# ── AI 接口（站内 AI 助手） ──
AI_BASE_URL=https://api.zhongzhuan.win/v1
AI_API_KEY=<AI 服务商提供的 key>
AI_MODEL=claude-opus-4-6

# ── 百度 OCR（截图识别，网络图片文字识别 webimage） ──
# 用途：src/lib/baidu-ocr.ts 换取 access_token 并调用识别接口
# 来源：百度智能云控制台 → 应用列表 → API Key / Secret Key
BAIDU_OCR_API_KEY=<百度智能云 → 应用详情 → API Key>
BAIDU_OCR_SECRET_KEY=<百度智能云 → 应用详情 → Secret Key>

# ── 抖音开放平台（服务端专用，转正后填写） ──
# client_key/client_secret 来自抖音开放平台网站应用；Token 只在服务端加密保存。
DOUYIN_CLIENT_KEY=<抖音开放平台网站应用 Client Key>
DOUYIN_CLIENT_SECRET=<抖音开放平台网站应用 Client Secret>
DOUYIN_REDIRECT_URI=https://dydata.cc/api/douyin/oauth/callback
# 32 字节十六进制密钥；首次生成后必须安全保存，轮换需配套迁移旧 Token。
DOUYIN_TOKEN_ENCRYPTION_KEY=<64 位十六进制字符串>

# ── CloudBase 隔离验证（生产默认继续使用 Supabase；切换须单独授权） ──
# 服务端与前端开关必须一致；NEXT_PUBLIC 值在构建时固定，修改后必须重新构建。
DYDATA_BACKEND=supabase
NEXT_PUBLIC_DYDATA_BACKEND=supabase
CLOUDBASE_ENV_ID=<CloudBase 上海隔离环境 ID>
NEXT_PUBLIC_CLOUDBASE_ENV_ID=<与服务端相同的环境 ID>
# 仅服务端使用；禁止 NEXT_PUBLIC 前缀。
CLOUDBASE_SERVICE_API_KEY=<隔离环境服务端 API Key>
# 用户归档/恢复所需腾讯云管理接口凭据；未配置时明确拒绝，不能假报成功。
# 正式接入前使用仅允许指定环境 ModifyUser 的最小权限凭据。
CLOUDBASE_SECRET_ID=<服务端最小权限 SecretId>
CLOUDBASE_SECRET_KEY=<服务端最小权限 SecretKey>
# STS 临时凭据需额外配置 Token；长期子账号凭据不填写此项。
CLOUDBASE_SESSION_TOKEN=<仅 STS 临时凭据需要>
# CloudBase 模式必须沿用 COS：SCREENSHOT_STORAGE=cos，并保留原桶/地域与授权密钥。
# 当前正式截图桶为新加坡；不要因为数据库在上海而改桶或迁移图片。

# 切换维护：仅在已授权窗口设1，动态访问（含读/API/Server Actions）将返回503。
# 默认0；窗口操作与恢复步骤见 docs/reference/切换执行手册.md。
DYDATA_WRITE_FREEZE=0
# 仅关闭页面IP限流，API限流仍然保留。共用办公出口的切换候选值为true。
# 默认false，不因本地示例自动修改任何部署配置。
RATE_LIMIT_DISABLED=false
