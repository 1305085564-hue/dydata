# ────────────────────────────────────────────────────────────
# DYData 环境变量模板（仅腾讯云 CloudBase 后台）
# 复制本文件为 .env.local 后填入真实值；禁止 commit 到 git。
# 本文件同时作为发版前线上设置项对账（scripts/cloudbase/check-env-vars.mjs）的唯一清单来源。
# 每项必须归属 [必填] 或 [可选] 分区。
# ────────────────────────────────────────────────────────────

# == [必填] ==

# ── 腾讯云 CloudBase（全站唯一后台与数据库） ──
# 服务端环境 ID（与 cloudbaserc.json 一致）
CLOUDBASE_ENV_ID=dydata-d6g0gd1v37fcddf21
# 前端构建期注入的环境 ID（修改后必须重新构建发版）
NEXT_PUBLIC_CLOUDBASE_ENV_ID=dydata-d6g0gd1v37fcddf21
# 仅服务端使用，禁止加 NEXT_PUBLIC 前缀
CLOUDBASE_SERVICE_API_KEY=<CloudBase 服务端 API Key>

# ── 站点域名与 CSRF 校验 ──
# 正式站点地址（构建期注入，用于 CSRF 与飞书跳转链接）
NEXT_PUBLIC_APP_URL=https://dydata.cc
# 服务端写请求可信来源（与正式域名一致）
SITE_ORIGIN=https://dydata.cc

# ── 腾讯云 COS 截图存储（私有桶） ──
COS_SECRET_ID=<腾讯云子账号 SecretId>
COS_SECRET_KEY=<腾讯云子账号 SecretKey>
COS_BUCKET=dydata-screenshot-sh-1409482292
COS_REGION=ap-shanghai
# 截图快速读取票据签名密钥（至少 32 字节随机字符串）
SCREENSHOT_GRANT_SECRET=<至少 32 字节的随机票据签名密钥>

# ── 定时任务鉴权 ──
# 腾讯云定时函数调用 /api/notifications/cleanup 使用 Authorization: Bearer <CRON_SECRET>
CRON_SECRET=<自定义随机字符串>

# ── 飞书机器人与自建应用 ──
# 员工群日报提交通知机器人 webhook（禁止用于系统报警或测试消息）
FEISHU_WEBHOOK_URL=<飞书自定义机器人 webhook 地址>
# 飞书自建应用机器人（事件回调与文档/选题协作）
FEISHU_APP_ID=<飞书开放平台 App ID>
FEISHU_APP_SECRET=<飞书开放平台 App Secret>
FEISHU_APP_ENCRYPT_KEY=<飞书事件与回调 Encrypt Key>
FEISHU_APP_VERIFICATION_TOKEN=<飞书事件与回调 Verification Token>

# == [可选] ==

# ── Sentry 错误监控（未配置 DSN 时不会向外发送） ──
NEXT_PUBLIC_SENTRY_DSN=<Sentry Client Keys DSN>
SENTRY_ORG=<Sentry organization slug（仅构建期上传 source map）>
SENTRY_PROJECT=<Sentry project slug（仅构建期上传 source map）>
SENTRY_AUTH_TOKEN=<Sentry auth token（仅构建期上传 source map）>
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=<发布版本号>

# ── COS 与截图票据调优 ──
COS_APP_ID=<腾讯云 AppId（可选附加标识）>
COS_READ_TIMEOUT_MS=3000
# 设为 0 可临时关闭截图快速票据，退回慢路径鉴权
SCREENSHOT_GRANT_ENABLED=1

# ── 定时任务手动触发与失败报警 ──
# 手动触发定时接口时的备用密钥（兼容 CRON_SECRET）
REMIND_SECRET=<自定义随机字符串>
# 定时任务失败报警群 webhook
FEISHU_ALERT_WEBHOOK_URL=<飞书报警群机器人 webhook 地址>

# ── 站内 AI 助手兜底配置（正式优先读取数据库算力池 ai_providers） ──
AI_BASE_URL=https://api.zhongzhuan.win/v1
AI_API_KEY=<AI 服务商 API Key>
AI_MODEL=claude-opus-4-6
# 设为 false 可强制停用数据库算力池、退回环境变量兜底
AI_CHANNELS_ENABLED=true
# Clairic 截图识别单次请求超时毫秒数（默认 5000）
CLAIRIC_OCR_TIMEOUT_MS=5000

# ── API 限流存储（Upstash Redis REST，未配时降级单实例内存限流） ──
UPSTASH_REDIS_REST_URL=<Upstash REST URL>
UPSTASH_REDIS_REST_TOKEN=<Upstash REST Token>
# 仅关闭页面 IP 限流，API 限流仍然保留
RATE_LIMIT_DISABLED=false

# ── 运维、诊断、维护窗口与兼容站点源 ──
# 设为 1 输出加载器与接口分步耗时日志
DYDATA_PERF_LOG=0
# 仅在授权维护窗口设为 1，动态访问返回 503
DYDATA_WRITE_FREEZE=0
DYDATA_CUTOVER_PROBE_TOKEN=<维护窗口只读探活令牌>
DYDATA_CUTOVER_PROBE_EXPIRES_AT=<维护窗口探活令牌 ISO 过期时间>
# 仅限本机：开发环境防误写正式库的显式放行开关（禁止配在线上）
DYDATA_DEV_ALLOW_PROD_WRITE=0
# 服务端内部回调基址（默认 http://localhost:3000）
APP_BASE_URL=http://localhost:3000
# CSRF 兼容站点源（一般只需配 SITE_ORIGIN 与 NEXT_PUBLIC_APP_URL）
APP_URL=
NEXT_PUBLIC_SITE_ORIGIN=
NEXT_PUBLIC_SITE_URL=
# 关闭 Next.js 遥测
NEXT_TELEMETRY_DISABLED=1
